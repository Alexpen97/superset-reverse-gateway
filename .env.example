# Copy to .env and adjust before `make up`.
# Local demo only — do not reuse these values outside a private machine.

# --- Postgres (shared instance, two databases) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SUPERSET_DB=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=superset
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# --- Local hostname (requires `make setup` → /etc/hosts + allow port 80) ---
# App:  http://demo.io/bi/
# Auth: http://demo.io/auth/  (Keycloak via the same gateway)
BI_HOSTNAME=demo.io
GATEWAY_PORT=80

# --- Superset ---
# Generate with: openssl rand -base64 42
SUPERSET_SECRET_KEY=change-me-to-a-long-random-string
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_APP_ROOT=/bi
AUTH_USER_REGISTRATION_ROLE=Admin

# --- Keycloak (browser: demo.io/auth via gateway; Superset: keycloak:8080/auth) ---
KEYCLOAK_EXTERNAL_URL=http://demo.io/auth
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=bi
KEYCLOAK_CLIENT_ID=superset
KEYCLOAK_CLIENT_SECRET=superset-client-secret-change-me
# Kept for smoke checks / docs (browser-facing). Superset uses INTERNAL_URL in config.
KEYCLOAK_DISCOVERY_URL=http://demo.io/auth/realms/bi/.well-known/openid-configuration
KEYCLOAK_API_BASE_URL=http://demo.io/auth/realms/bi/protocol/openid-connect/

# --- Gateway (loopback only — vulhub image is intentionally vulnerable) ---
GATEWAY_HOST_BIND=127.0.0.1
GATEWAY_URL=http://demo.io
